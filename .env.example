# ── 필수 ──────────────────────────────────────────────────────────
# 기록 검증 토큰 서명 키. 웹과 소켓 서버가 반드시 같은 값을 써야 한다.
# 이 값이 새면 랭킹 전체를 위조할 수 있다.
#   openssl rand -base64 32
SCORE_SECRET=

# 순위표에서 기록을 내리는 문(POST /api/admin/hide)의 열쇠.
# 비워 두면 그 문은 아예 없는 것으로 동작한다 — 404를 돌려준다.
# 16자보다 짧으면 심지 않은 것으로 친다.
#   openssl rand -base64 32
#
#   curl -X POST https://sigun-typing.ysw.kr/api/admin/hide \
#     -H "x-admin-token: $ADMIN_TOKEN" -H "content-type: application/json" \
#     -d '{"id":"<기록 id>","reason":"욕설"}'
#     -d '{"deviceId":"<기기 id>","reason":"도배"}'   # 그 기기가 올린 것 전부
ADMIN_TOKEN=

# ── 리버스 프록시가 붙을 포트 ─────────────────────────────────────
# 프록시가 같은 호스트에 있으면 127.0.0.1 그대로 둔다.
# 다른 호스트에서 붙어야 하면 0.0.0.0으로 바꾸고 방화벽으로 막는다.
BIND_ADDR=127.0.0.1
# 흔한 포트(3000/8080)는 같은 호스트의 다른 서비스와 부딪힌다.
# 커널 ephemeral 범위(보통 32768~60999)보다 아래여야 한다 — 그 안이면
# 아웃바운드 연결이 포트를 먼저 잡아 재시작 때 간헐적으로 바인딩이 실패한다.
WEB_PORT=18730
SOCKET_PORT=18731

# 소켓 서버가 허용할 출처. 실제 서비스 주소와 정확히 같아야 한다.
APP_ORIGIN=https://sigun-typing.ysw.kr

# sitemap.xml과 robots.txt가 쓸 절대 주소. 빌드 시점에 박힌다.
SITE_URL=https://sigun-typing.ysw.kr

# ── 실험 ──────────────────────────────────────────────────────────
# 실제 배포 시각. 퍼널 조회에서 이보다 앞선 이벤트(개발·QA)를 잘라낸다.
# 실험 버전만으로는 걸러지지 않는다 — 버전은 같고 사람만 다르기 때문이다.
# 새 실험을 시작할 때마다 함께 갱신한다.
EXPERIMENT_STARTED_AT=

# ── Postgres ──────────────────────────────────────────────────────
# db 컨테이너는 포트를 열지 않는다. 같은 compose 네트워크 안에서만 붙는다.
POSTGRES_USER=sigun
POSTGRES_PASSWORD=
POSTGRES_DB=sigun

# compose 밖에서 직접 돌릴 때만 쓴다. 비워 두면 메모리 저장소로 떠서
# 기록이 유지되지 않는다(개발 전용, 운영에서는 예외를 던진다).
DATABASE_URL=postgres://sigun:sigun@localhost:5432/sigun

# ── 카카오 공유 ───────────────────────────────────────────────────
# developers.kakao.com > 내 애플리케이션 > 앱 키 > JavaScript 키.
# 브라우저에 드러나는 것이 정상인 값이다. 막는 것은 키가 아니라 콘솔의
# `플랫폼 > Web > 사이트 도메인`이라, 서비스 주소를 거기 등록해야 동작한다.
# REST API 키는 여기 넣지 않는다 — 서버 키이고 이 기능에 쓰이지 않는다.
#
# 비워 두면 결과 화면에 카카오톡 단추가 안 그려진다. 빌드 시점에 번들에 박히므로
# 값을 바꾸면 이미지를 다시 빌드해야 한다.
NEXT_PUBLIC_KAKAO_JS_KEY=

# ── 거의 건드릴 일 없음 ───────────────────────────────────────────
# 운영에서는 반드시 비워 둔다. 비어 있으면 브라우저가 현재 오리진의
# /socket.io/ 로 붙으므로 프록시 설정만으로 끝난다.
# 이 값은 빌드 시점에 번들에 박히므로, 도메인을 넣으면 도메인이 바뀔 때마다
# 이미지를 다시 빌드해야 한다.
NEXT_PUBLIC_SOCKET_URL=
