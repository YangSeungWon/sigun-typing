{
  "name": "sigun-typing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:geo": "node scripts/build-geo.mts",
    "build:dong": "node scripts/build-dong-courses.mts",
    "build:changes": "node scripts/build-changes.mts",
    "build:timelapse": "node scripts/build-timelapse.mts",
    "build:events": "node scripts/build-history-events.mts",
    "build:dong-history": "node scripts/build-dong-history.mts",
    "build:terrain": "node scripts/build-terrain.mts",
    "build:og": "node scripts/build-og.mts",
    "build:thumbs": "node scripts/build-thumbs.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "dev:socket": "tsx watch server/index.mts",
    "start:socket": "tsx server/index.mts",
    "drill:ops": "tsx --tsconfig tsconfig.scripts.json scripts/ops-drill.mts",
    "drill:restore": "sh scripts/restore-drill.sh"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "16.3.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3-contour": "^3.0.6",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/polylabel": "^2.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "d3-contour": "^4.0.2",
    "d3-geo": "^3.1.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "mapshaper": "^0.7.51",
    "playwright": "^1.62.1",
    "polylabel": "^2.1.0",
    "tailwindcss": "^4",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.8",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.18.2"
}
